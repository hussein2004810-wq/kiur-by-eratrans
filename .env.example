# Comma-separated, site-specific authenticated user IDs that own KIUR.
OWNER_USER_IDS=replace-with-site-user-id

# Random secrets, each at least 32 characters. Never expose them through VITE_*.
PASSWORD_PEPPER=replace-with-a-random-32-plus-character-secret
DEVICE_HASH_PEPPER=replace-with-a-different-random-32-plus-character-secret

# Firebase Authentication (Email/Password provider). The Web API key identifies
# the Firebase project and is safe to use server-side; never add service-account
# private keys or Google account passwords here.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_AUTH_PROJECT_ID=replace-with-firebase-project-id
# The browser receives only the Firebase web API key, project ID, and derived
# firebaseapp.com auth domain. Firebase web API keys identify a project and must
# remain restricted to Firebase APIs; service-account keys stay server-only.
# Canonical HTTPS origin used in share links and social metadata.
PUBLIC_ORIGIN=https://medexam-iraq-2026.hussein2004810.chatgpt.site
