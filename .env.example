# Comma-separated, site-specific authenticated user IDs that own KIUR.
OWNER_USER_IDS=replace-with-site-user-id

# Random secrets, each at least 32 characters. Never expose them through VITE_*.
PASSWORD_PEPPER=replace-with-a-random-32-plus-character-secret
DEVICE_HASH_PEPPER=replace-with-a-different-random-32-plus-character-secret

# HTTPS endpoint that accepts verification/invitation JSON and sends the email.
EMAIL_VERIFICATION_WEBHOOK_URL=https://your-mail-service.example/kiur/security-email
EMAIL_VERIFICATION_SECRET=replace-with-webhook-bearer-secret

# Simpler alternative: direct transactional email through Resend.
RESEND_API_KEY=re_replace-with-resend-api-key
EMAIL_FROM=KIUR by ERATRANS <no-reply@your-verified-domain.example>

# Domain-free starter option: verify an ordinary sender address in Brevo.
BREVO_API_KEY=xkeysib-replace-with-brevo-api-key
EMAIL_FROM_ADDRESS=your-sender@gmail.com
EMAIL_FROM_NAME=KIUR by ERATRANS
